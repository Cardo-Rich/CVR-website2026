rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    // Journal: one doc per live article, plus its 30-day revision history and
    // a separate collection of pending drafts. The public site reads these
    // through Cloud Functions (Admin SDK), never directly.
    match /articles/{id} {
      allow read, write: if isAdmin();
      match /revisions/{rev} { allow read, write: if isAdmin(); }
    }
    match /articleDrafts/{id} { allow read, write: if isAdmin(); }
    match /caseStudies/{id}  { allow read, write: if isAdmin(); }
    match /properties/{id}   { allow read: if isAdmin(); allow write: if false; } // sync-only (server)
    match /homepage/{id}     { allow read, write: if isAdmin(); }
    match /config/{id}       { allow read, write: if isAdmin(); }

    // All agreement access is mediated by Cloud Functions (Admin SDK). No client reads/writes.
    match /agreements/{token} { allow read, write: if false; }
  }
}
