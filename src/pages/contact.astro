---
// Contact page. The form sits first in <main> on purpose: it is the opt-in URL
// on the A2P 10DLC campaign, and HighLevel's compliance scan reads only the
// first part of a page's HTML, so the SMS consent block must come early.
import Base from '../layouts/Base.astro';
import MarketingHeader from '../components/sections/MarketingHeader.astro';
import Footer from '../components/sections/Footer.astro';
import SmsConsent from '../components/ui/SmsConsent.astro';
import { company } from '../data/site';
---

<Base
  title="Contact Us | Cardo Vacation Rentals"
  description="Contact Cardo Vacation Rentals, a San Diego short-term rental management company. Send a message, call 619-719-5282, or email service@cardorentals.com."
>
  <MarketingHeader />
  <main>
    <section class="section-pad ct" data-screen-label="Contact">
      <div class="ct__wrap">
        <form class="ct-form" data-contact-form novalidate>
          <p class="eyebrow">Contact us</p>
          <h1>Send us a message</h1>
          <p class="muted ct-form__intro">Homeowners, guests, agents, and vendors can reach our San Diego team here. We reply within one business day. Fields marked * are required.</p>
          <div class="ct-form__grid">
            <label>Name *<input name="Name" type="text" required autocomplete="name" /></label>
            <label>Email *<input name="Email" type="email" required autocomplete="email" /></label>
            <label>Mobile phone<input name="Phone" type="tel" autocomplete="tel" /></label>
            <label>I am a
              <select name="Topic">
                <option>Homeowner</option>
                <option>Guest</option>
                <option>Real estate agent</option>
                <option>Vendor</option>
                <option>Other</option>
              </select>
            </label>
            <label class="ct-form__wide">Message *<textarea name="Message" rows="4" required></textarea></label>
          </div>
          <SmsConsent />
          <div class="ct-form__foot">
            <button class="btn btn-lg" type="submit">Send message</button>
            <p class="ct-form__note" data-contact-status aria-live="polite"></p>
          </div>
        </form>

        <aside class="ct-info">
          <h2>Cardo Vacation Rentals</h2>
          <p class="muted">{company.legalName}, doing business as {company.name}</p>
          <p><strong>Phone:</strong> <a href={`tel:${company.phoneHref}`}>{company.phone}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${company.email}`}>{company.email}</a></p>
          <p><strong>Office:</strong><br />{company.address.street}<br />{company.address.city}, {company.address.region} {company.address.postalCode}</p>
          <p class="muted ct-info__legal">See our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.</p>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .ct { padding-top: 128px; }
  .ct__wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  .ct-form { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(22px, 4vw, 36px); box-shadow: var(--shadow-sm); }
  .ct-form h1 { margin: 6px 0 10px; font-size: clamp(1.8rem, 3.4vw, 2.4rem); }
  .ct-form__intro { margin: 0 0 22px; line-height: 1.6; }
  .ct-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .ct-form label { display: flex; flex-direction: column; gap: 6px; font-size: .88rem; font-weight: 600; color: var(--ink); }
  .ct-form__wide { grid-column: 1 / -1; }
  .ct-form input, .ct-form textarea, .ct-form select { font: inherit; font-weight: 400; color: var(--ink); background: var(--cream); border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; width: 100%; }
  .ct-form input:focus, .ct-form textarea:focus, .ct-form select:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(193,154,91,.18); }
  .ct-form textarea { resize: vertical; min-height: 96px; }
  .ct-form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 18px; }
  .ct-form__note { margin: 0; flex: 1; min-width: 220px; font-size: .88rem; color: var(--muted); }
  .ct-form__note.is-sent { color: var(--success, #2e7d32); font-weight: 600; }
  .ct-info h2 { margin: 8px 0 6px; font-size: 1.35rem; }
  .ct-info p { margin: 0 0 14px; line-height: 1.6; }
  .ct-info a { color: var(--rose); }
  .ct-info__legal { font-size: .88rem; }
  @media (max-width: 820px) {
    .ct__wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .ct-form__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { wireLeadForm } from '../scripts/lead-form.js';

  wireLeadForm({
    form: '[data-contact-form]',
    type: 'contact',
    nameField: 'Name',
    emailField: 'Email',
    phoneField: 'Phone',
    fallbackTo: 'service@cardorentals.com',
    subject: 'Website contact',
    status: '[data-contact-status]',
    successText: 'Thanks! Your message is in. We reply within one business day.',
  });
</script>
