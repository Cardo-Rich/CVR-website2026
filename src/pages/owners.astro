---
import Base from '../layouts/Base.astro';
import MarketingHeader from '../components/sections/MarketingHeader.astro';
import Footer from '../components/sections/Footer.astro';
import OwnerHero from '../components/owners/OwnerHero.astro';
import ByTheNumbers from '../components/owners/ByTheNumbers.astro';
import Partners from '../components/owners/Partners.astro';
import AirbnbProof from '../components/owners/AirbnbProof.astro';
import Reviews from '../components/home/Reviews.astro';
import Performance from '../components/owners/Performance.astro';
import CaseStudies from '../components/owners/CaseStudies.astro';
import Marketing from '../components/owners/Marketing.astro';
import Assurance from '../components/owners/Assurance.astro';
import Investors from '../components/owners/Investors.astro';
import Compare from '../components/owners/Compare.astro';
import Team from '../components/owners/Team.astro';
import Testimonials from '../components/owners/Testimonials.astro';
import Founder from '../components/owners/Founder.astro';
import Process from '../components/owners/Process.astro';
import Faq from '../components/owners/Faq.astro';
import TeamModal from '../components/owners/TeamModal.astro';
import CaseModal from '../components/owners/CaseModal.astro';
import '../styles/home.css';
import '../styles/owners.css';

// Service schema — tells Google/Bing-fed answer surfaces exactly what this page
// sells and where, linked back to the sitewide LocalBusiness entity (Base.astro
// renders it with @id ".../#organization" on every page).
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://cardorentals.com/owners#service',
  name: 'Short-Term Rental Property Management',
  serviceType: 'Vacation rental and Airbnb property management',
  description:
    'Full-service luxury short-term rental management in San Diego: in-house design, professional marketing, dynamic pricing, STRO licensing and TOT compliance, guest care, and transparent owner accounting.',
  provider: { '@id': 'https://cardorentals.com/#organization' },
  areaServed: [
    'La Jolla',
    'Pacific Beach',
    'Mission Beach',
    'Del Mar',
    'Encinitas',
    'Carlsbad',
    'Coronado',
    'San Diego',
  ].map((name) => ({ '@type': 'City', name })),
  url: 'https://cardorentals.com/owners',
};
const serviceSchemaJson = JSON.stringify(serviceSchema);
---

<Base title="Luxury Vacation Rental Management | Cardo Vacation Rentals" description="Luxury San Diego vacation rental management — a free earning estimate, above-market revenue, and full-service marketing. 5-star Superhost since 2013." image="/assets/og/og-owners.jpg" imageAlt="Cardo Vacation Rentals — luxury short-term rental management in San Diego">
  <script slot="head" type="application/ld+json" is:inline set:html={serviceSchemaJson} />
  <MarketingHeader />
  <main>
    <OwnerHero />
    <Performance />
    <Assurance />
    <Compare />
    <Marketing />
    <ByTheNumbers />
    <Partners />
    <CaseStudies />
    <Reviews><AirbnbProof /></Reviews>
    <Testimonials />
    <Team />
    <Founder />
    <Investors />
    <Process />
    <Faq />
  </main>
  <a class="btn estimate-fab" data-estimate-fab href="#estimate">Schedule a consultation</a>
  <aside class="estimate-card" data-estimate-fab>
    <h3>Surpass the competition today</h3>
    <p class="estimate-card__sub">Cardo-designed homes outperform their market by up to 32%</p>
    <a href="#estimate" class="btn estimate-card__btn">Schedule a consultation</a>
  </aside>
  <TeamModal />
  <CaseModal />
  <Footer />
</Base>

<script>
  import '../scripts/owners.js';
  import '../scripts/sections.js';
  import '../scripts/home-interactive.js';
  import '../scripts/team-modal.js';
  import '../scripts/guest.js';
</script>
