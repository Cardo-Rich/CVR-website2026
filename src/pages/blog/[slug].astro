---
import Base from '../../layouts/Base.astro';
import MarketingHeader from '../../components/sections/MarketingHeader.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleView from '../../components/blog/ArticleView.astro';
import { getPublishedArticles } from '../../lib/content/articles';
import { getNeighborhoods } from '../../lib/content/neighborhoods';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const neighborhoods = await getNeighborhoods();
  return articles.map((a, i) => {
    // Neighborhoods this article names (title/excerpt) → link through to those
    // market pages. Precise by design: only areas the post is actually about.
    const haystack = `${a.title} ${a.excerpt}`;
    const areas = neighborhoods.filter((nh) => haystack.includes(nh.name)).slice(0, 3);
    return {
      params: { slug: a.slug },
      props: { a, related: [articles[(i+1)%articles.length], articles[(i+2)%articles.length], articles[(i+3)%articles.length]], areas },
    };
  });
}
const { a, related, areas } = Astro.props;
const nav = [
  { label: 'For Owners', href: '/owners' },
  { label: 'Design', href: '/home-designs' },
  { label: 'Case studies', href: '/home-designs#case-studies' },
  { label: 'Blog', href: '/blog', active: true },
];
const cta = { label: 'Free estimate', href: '/owners#estimate' };

// Guest-facing "explore" guides (surf, food, family) get a booking CTA; owner
// articles get the earning-estimate CTA. showOnHome marks the guest guides.
const isGuestGuide = a.showOnHome === true;

// Structured data (BlogPosting) so search engines and AI answer engines can
// read the article cleanly. Built from the article's own fields.
const isoDate = (() => { const d = new Date(a.dateFull); return isNaN(d.getTime()) ? undefined : d.toISOString(); })();
const canonical = `https://cardorentals.com/blog/${a.slug}`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: a.title,
  description: a.seo?.description || a.excerpt,
  image: a.img ? [a.img] : undefined,
  datePublished: isoDate,
  dateModified: isoDate,
  author: { '@type': 'Organization', name: a.author?.name || 'Cardo Vacation Rentals', url: 'https://cardorentals.com' },
  publisher: { '@type': 'Organization', name: 'Cardo Vacation Rentals', logo: { '@type': 'ImageObject', url: 'https://cardorentals.com/assets/logo-horizontal-color.png' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: a.category,
});

// Breadcrumb trail (Home › The Cardo Journal › this article) so search results
// can render the breadcrumb line instead of a bare URL.
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cardorentals.com/' },
    { '@type': 'ListItem', position: 2, name: 'The Cardo Journal', item: 'https://cardorentals.com/blog' },
    { '@type': 'ListItem', position: 3, name: a.title, item: canonical },
  ],
});
---

<Base
  title={a.seo.title}
  description={a.seo.description}
  image={a.img}
  imageAlt={a.heroCaption || a.title}
  type="article"
  canonical={canonical}
  publishedTime={isoDate}
  modifiedTime={isoDate}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <script slot="head" type="application/ld+json" is:inline set:html={breadcrumbLd} />
  <MarketingHeader {nav} {cta} />

  <main>
    <ArticleView {a} {related} {areas} {isGuestGuide} />
  </main>

  <Footer />
</Base>

<script>
  import '../../scripts/reveal.js';
  import '../../scripts/blog.js';
</script>
