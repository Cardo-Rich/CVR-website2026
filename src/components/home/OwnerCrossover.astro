---
import { homePhotos } from '../../data/home';
import { ownerReviews } from '../../data/owner-reviews';

// Feature the first three real Google/Yelp owner reviews from the same source
// the owners page uses (src/data/owner-reviews.ts). Reorder there and the home
// page follows.
const featured = ownerReviews.filter((r) => r.wall).slice(0, 3);

// Teaser excerpt from the full review text, trimmed at a word boundary and
// kept under 100 characters. Tapping "Read all owner reviews" shows the rest.
function excerpt(s: string, max = 99): string {
  const clean = s.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  let cut = clean.slice(0, max - 1);
  const lastSpace = cut.lastIndexOf(' ');
  if (lastSpace > 40) cut = cut.slice(0, lastSpace);
  return cut.replace(/[\s,.;:!?—-]+$/, '') + '…';
}

const GBADGE = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>';
const YMARK = '<img class="src-yelp" src="/assets/badges/yelp-logo.svg" alt="Yelp" />';
---

<section class="crossover" data-screen-label="For owners">
  <img class="crossover__bg" src={homePhotos['living-fireplace']} alt="" loading="lazy" decoding="async" />
  <div class="crossover__inner">
    <div class="reveal">
      <p class="eyebrow">Own a home in San Diego?</p>
      <h2>Guests love the stay. Owners love the returns.</h2>
      <p>The same care that makes a guest rebook is what keeps your calendar full and your reviews at five stars. If this is how you'd want your home run — let's talk.</p>
      <div class="crossover__stats">
        <div class="crossover__stat"><div class="v">+15%</div><div class="l">higher RevPAR vs market</div></div>
        <div class="crossover__stat"><div class="v">$80M+</div><div class="l">under management</div></div>
        <div class="crossover__stat"><div class="v">Since 2013</div><div class="l">San Diego Superhost</div></div>
      </div>
    </div>
    <div class="crossover__actions reveal">
      <a href="/owners#estimate" class="btn btn-lg">Schedule a consultation</a>
    </div>
  </div>
  <div class="crossover__owners" style="position:relative;z-index:2;max-width:var(--container);margin:0 auto;padding:0 24px;">
    <p class="eyebrow reveal" style="color:#fff;justify-content:center;text-align:center">What owners say</p>
    <div class="ownrev reveal">
      {featured.map((r) => (
        <div class="ownrev__card">
          <div class="ownrev__stars">{'★'.repeat(r.rating)}</div>
          <p class="ownrev__text">{excerpt(r.text)}</p>
          <div class="ownrev__who">
            <span class="ownrev__src" set:html={r.source === 'google' ? GBADGE : YMARK} />
            <div>
              <div class="ownrev__name">{r.name}</div>
              <div class="ownrev__home">Verified {r.source === 'google' ? 'Google' : 'Yelp'} review</div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="ownrev__more reveal">
      <a href="/owners#owner-reviews" class="btn btn-ghost-light">Read all owner reviews</a>
    </div>
  </div>
</section>
