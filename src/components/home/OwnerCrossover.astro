---
import { homePhotos } from '../../data/home';
import { ownerReviews } from '../../data/owner-reviews';

// Feature the first three real Google/Yelp owner reviews from the same source
// the owners page uses (src/data/owner-reviews.ts). Reorder there and the home
// page follows.
const featured = ownerReviews.filter((r) => r.wall).slice(0, 3);

// A ~200-character teaser from the full review text. Prefer ending on a clean
// sentence boundary; otherwise trim at a word boundary and add an ellipsis.
// The complete review is one tap away via "Read all owner reviews".
function excerpt(s: string, max = 200): string {
  const clean = s.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const window = clean.slice(0, max);
  const sentenceEnd = Math.max(window.lastIndexOf('. '), window.lastIndexOf('! '), window.lastIndexOf('? '));
  if (sentenceEnd >= 120) return window.slice(0, sentenceEnd + 1); // clean full sentence(s)
  let cut = window.slice(0, max - 1);
  const lastSpace = cut.lastIndexOf(' ');
  if (lastSpace > 80) cut = cut.slice(0, lastSpace);
  return cut.replace(/[\s,.;:!?—-]+$/, '') + '…';
}

const GBADGE = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>';
const YMARK = '<img class="src-yelp" src="/assets/badges/yelp-logo.svg" alt="Yelp" />';
---

<section class="crossover" data-screen-label="For owners">
  <img class="crossover__bg" src={homePhotos['living-fireplace']} alt="" loading="lazy" decoding="async" />
  <div class="crossover__inner">
    <div class="reveal">
      <p class="eyebrow">Own a home in San Diego?</p>
      <h2>Guests love the stay. Owners love the returns.</h2>
      <p>The same care that makes a guest rebook is what keeps your calendar full and your reviews at five stars. If this is how you'd want your home run, let's talk.</p>
      <div class="crossover__stats">
        <div class="crossover__stat"><div class="v">Up to 32%</div><div class="l">over market</div></div>
        <div class="crossover__stat"><div class="v">$80M+</div><div class="l">under management</div></div>
        <div class="crossover__stat"><div class="v">Since 2013</div><div class="l">San Diego Superhost</div></div>
      </div>
    </div>
    <div class="crossover__actions reveal">
      <a href="/owners#estimate" class="btn btn-lg">Schedule a consultation</a>
    </div>
  </div>
  <div class="crossover__owners" style="position:relative;z-index:2;max-width:var(--container);margin:0 auto;padding:0 24px;">
    <p class="eyebrow reveal" style="color:#fff;justify-content:center;text-align:center">What owners say</p>
    <div class="ownrev reveal" data-ohm-wall>
      {featured.map((r) => (
        <div class="ownrev__card" role="button" tabindex="0" aria-label={`Read ${r.name}'s full review`}>
          <div class="ownrev__stars">{'★'.repeat(r.rating)}</div>
          <p class="ownrev__text">{excerpt(r.text)}</p>
          <div class="ownrev__who">
            <span class="ownrev__src" set:html={r.source === 'google' ? GBADGE : YMARK} />
            <div>
              <div class="ownrev__name">{r.name}</div>
              <div class="ownrev__home">Verified {r.source === 'google' ? 'Google' : 'Yelp'} review</div>
            </div>
          </div>
          <span class="ownrev__cue">Read full review<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          <script type="application/json" data-ohm-data set:html={JSON.stringify({ name: r.name, source: r.source, rating: r.rating, text: r.text })}></script>
        </div>
      ))}
    </div>
    <div class="ownrev__more reveal">
      <a href="/owners#owner-reviews" class="btn btn-ghost-light">Read all owner reviews</a>
    </div>
  </div>

  <!-- Read-full modal (populated on card tap) -->
  <div class="ohm" data-ohm-modal hidden aria-hidden="true">
    <div class="ohm__scrim" data-ohm-close></div>
    <div class="ohm__panel" role="dialog" aria-modal="true" aria-label="Owner review">
      <button type="button" class="ohm__close" data-ohm-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="ohm__top">
        <span class="ohm__mark" data-ohm-mark></span>
        <div class="ohm__id">
          <div class="ohm__name" data-ohm-name></div>
          <div class="ohm__meta" data-ohm-meta></div>
        </div>
        <span class="ohm__stars" data-ohm-stars>★★★★★</span>
      </div>
      <div class="ohm__text" data-ohm-text></div>
    </div>
  </div>
</section>

<style is:global>
  /* Home "What owners say" — read-full modal (global so JS-built paragraphs
     inside .ohm__text are styled too). */
  .ohm { position: fixed; inset: 0; z-index: 200; display: flex; }
  .ohm[hidden] { display: none; }
  .ohm__scrim { position: absolute; inset: 0; background: rgba(14,17,27,.55); backdrop-filter: blur(2px); opacity: 0; transition: opacity .3s var(--ease); }
  .ohm.is-open .ohm__scrim { opacity: 1; }
  .ohm__panel { position: relative; margin: auto; width: min(680px, 100%); max-height: 90vh; background: var(--paper); border-radius: var(--radius-lg); display: flex; flex-direction: column; box-shadow: 0 30px 80px rgba(0,0,0,.4); transform: translateY(16px) scale(.98); opacity: 0; transition: transform .35s var(--ease), opacity .35s var(--ease); padding: clamp(28px,4vw,44px); overflow-y: auto; }
  .ohm.is-open .ohm__panel { transform: none; opacity: 1; }
  @media (max-width: 600px) { .ohm__panel { max-height: 100vh; height: 100%; border-radius: 0; width: 100%; } }
  .ohm__close { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: var(--paper); color: var(--ink); cursor: pointer; display: grid; place-items: center; z-index: 2; }
  .ohm__close:hover { background: var(--ink); color: #fff; }
  .ohm__close svg { width: 18px; height: 18px; }
  .ohm__top { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-right: 40px; }
  .ohm__mark { flex: none; display: inline-flex; }
  .ohm__mark svg { width: 26px; height: 26px; }
  .ohm__mark .src-yelp { height: 24px; width: auto; }
  .ohm__id { min-width: 0; }
  .ohm__name { font-weight: 700; font-size: 1.1rem; }
  .ohm__meta { font-size: .85rem; color: var(--muted); }
  .ohm__meta:empty { display: none; }
  .ohm__stars { margin-left: auto; color: var(--gold); letter-spacing: 1px; white-space: nowrap; }
  .ohm__text p { margin: 0 0 12px; color: var(--ink-soft, #3a4048); line-height: 1.65; font-size: 1.02rem; }
  .ohm__text p:last-child { margin-bottom: 0; }
</style>

<script>
  (function () {
    var wall = document.querySelector('[data-ohm-wall]');
    var modal = document.querySelector('[data-ohm-modal]');
    if (!wall || !modal) return;
    var mark = modal.querySelector('[data-ohm-mark]');
    var nameEl = modal.querySelector('[data-ohm-name]');
    var metaEl = modal.querySelector('[data-ohm-meta]');
    var starsEl = modal.querySelector('[data-ohm-stars]');
    var textEl = modal.querySelector('[data-ohm-text]');
    var lastFocus = null;

    function open(card) {
      var data = {};
      try { data = JSON.parse(card.querySelector('[data-ohm-data]').textContent); } catch (e) {}
      var src = card.querySelector('.ownrev__src');
      mark.innerHTML = src ? src.innerHTML : '';
      nameEl.textContent = data.name || '';
      metaEl.textContent = 'Verified ' + (data.source === 'google' ? 'Google' : 'Yelp') + ' review';
      starsEl.textContent = '★★★★★'.slice(0, data.rating || 5);
      textEl.innerHTML = '';
      String(data.text || '').split(/\n\s*\n/).forEach(function (par) {
        var p = document.createElement('p'); p.textContent = par.trim();
        if (p.textContent) textEl.appendChild(p);
      });
      lastFocus = document.activeElement;
      modal.hidden = false; modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(function () { requestAnimationFrame(function () { modal.classList.add('is-open'); }); });
      var closeBtn = modal.querySelector('.ohm__close'); if (closeBtn) closeBtn.focus();
    }
    function close() {
      modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      setTimeout(function () { modal.hidden = true; }, 300);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    wall.addEventListener('click', function (e) {
      var card = e.target.closest && e.target.closest('.ownrev__card');
      if (card) open(card);
    });
    wall.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var card = e.target.closest && e.target.closest('.ownrev__card');
      if (card) { e.preventDefault(); open(card); }
    });
    modal.querySelectorAll('[data-ohm-close]').forEach(function (el) { el.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();
</script>
