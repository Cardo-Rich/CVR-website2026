---
// Owner testimonials — a full-width "quote wall": high-impact pull-quotes at
// varied sizes (like a wall of critic reviews). Tap any quote to read the full
// review in a modal. Data from src/data/owner-reviews.ts. `location` is
// editable per review in the CMS (admin "What owners say" editor).
import { ownerReviews } from '../../data/owner-reviews';

const wall = ownerReviews.filter((r) => r.wall);
const slug = (r: { name: string; source: string }) => (r.name + '-' + r.source).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

const GBADGE = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>';
const YMARK = '<img class="src-yelp" src="/assets/badges/yelp-logo.svg" alt="Yelp" />';
---

<section class="otest" id="owner-reviews" data-screen-label="Owner testimonials" data-section="owner-testimonials" data-cms="owner-testimonials">
  <div class="otest__head reveal">
    <p class="eyebrow center">What owners say</p>
    <h2>Owners who switched, and never looked back.</h2>
    <p class="otest__sub">Real reviews from San Diego homeowners on Google &amp; Yelp. Tap any quote to read the full review.</p>
  </div>

  <div class="qwall" data-qwall>
    {wall.map((r, i) => (
      <div class:list={['qcard', `qcard--${r.size || 'md'}`, { 'qcard--extra': i >= 3 }]} role="button" tabindex="0" aria-label={`Read ${r.name}'s full review`} data-qidx={i} data-ot-id={slug(r)}>
        <span class="qcard__mark" set:html={r.source === 'google' ? GBADGE : YMARK} />
        <blockquote class="qcard__quote">{r.pullQuote}</blockquote>
        <span class="qcard__who">
          <span class="qcard__name">{r.name}</span>
          <span class="qcard__loc" data-ot-loc>{r.location}</span>
        </span>
        <span class="qcard__cue">Read review<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </div>
    ))}
  </div>
  <div class="qwall__more"><button type="button" class="qwall__more-btn" data-qmore>Load more reviews</button></div>

  <script type="application/json" data-owner-json set:html={JSON.stringify(wall)}></script>

  <!-- Read-full modal (populated by owners.js on tap) -->
  <div class="orv" data-orv hidden aria-hidden="true">
    <div class="orv__scrim" data-orv-close></div>
    <div class="orv__panel" role="dialog" aria-modal="true" aria-label="Owner review">
      <button type="button" class="orv__close" data-orv-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="orv__body">
        <div class="orv__top">
          <span class="orv__mark" data-orv-mark></span>
          <div class="orv__id">
            <div class="orv__name" data-orv-name></div>
            <div class="orv__meta" data-orv-loc></div>
          </div>
          <span class="orv__stars" data-orv-stars>★★★★★</span>
        </div>
        <div class="orv__text" data-orv-text></div>
      </div>
    </div>
  </div>
</section>

<style>
  .otest { background: var(--cream); padding: clamp(48px,7vw,88px) 0; }
  .otest__head { max-width: 720px; margin: 0 auto 40px; padding: 0 24px; text-align: center; }
  .otest__head h2 { margin: 8px 0 12px; }
  .otest__sub { color: var(--muted); margin: 0; }

  /* Quote wall — full width, masonry flow, varied sizes */
  .qwall { column-gap: clamp(20px,3vw,40px); padding: 0 clamp(24px,5vw,72px); columns: 4; }
  @media (max-width: 1400px) { .qwall { columns: 3; } }
  @media (max-width: 1000px) { .qwall { columns: 2; } }
  @media (max-width: 640px)  { .qwall { columns: 1; } }

  .qcard { position: relative; break-inside: avoid; display: block; width: 100%; text-align: left; margin: 0 0 clamp(20px,2.4vw,34px); padding: 22px 22px 20px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); cursor: pointer; font-family: inherit; color: var(--ink); transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  .qcard:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--line-strong, rgba(14,17,27,.2)); }
  .qcard__mark { display: block; height: 20px; margin-bottom: 14px; }
  .qcard__mark svg { height: 20px; width: 20px; display: block; }
  .qcard__mark .src-yelp { height: 20px; width: auto; display: block; }
  .qcard__quote { margin: 0; font-family: var(--font-display); font-weight: 500; line-height: 1.24; color: var(--ink); text-wrap: pretty; }
  .qcard__quote::before { content: '\201C'; }
  .qcard__quote::after { content: '\201D'; }
  .qcard--xl .qcard__quote { font-size: clamp(1.8rem, 2.4vw, 2.5rem); }
  .qcard--lg .qcard__quote { font-size: clamp(1.5rem, 2vw, 2rem); }
  .qcard--md .qcard__quote { font-size: clamp(1.25rem, 1.5vw, 1.55rem); }
  .qcard--sm .qcard__quote { font-size: 1.15rem; }
  .qcard__who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin-top: 16px; }
  .qcard__name { font-weight: 600; font-size: .95rem; }
  .qcard__loc { font-size: .85rem; color: var(--muted); }
  .qcard__loc:empty { display: none; }
  .qcard__cue { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; font-size: .82rem; font-weight: 600; color: var(--rose); opacity: 0; transition: opacity var(--dur-fast) var(--ease); }
  .qcard__cue svg { width: 14px; height: 14px; }
  .qcard:hover .qcard__cue { opacity: 1; }

  .qwall__more { text-align: center; margin-top: 8px; }
  .qwall__more-btn { display: none; align-items: center; gap: 10px; font-weight: 600; font-size: 1rem; color: var(--ink); background: transparent; border: 1px solid var(--line-strong, rgba(14,17,27,.22)); border-radius: var(--radius-pill); padding: 13px 26px; cursor: pointer; }
  .qwall__more-btn:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  /* Mobile: 3 shown, rest revealed by "Load more" */
  @media (max-width: 640px) {
    .qcard--extra[hidden] { display: none; }
    .qwall.is-collapsed .qcard--extra { display: none; }
    .qwall.is-collapsed + .qwall__more .qwall__more-btn { display: inline-flex; }
  }

  /* Read-full modal */
  .orv { position: fixed; inset: 0; z-index: 200; display: flex; }
  .orv[hidden] { display: none; }
  .orv__scrim { position: absolute; inset: 0; background: rgba(14,17,27,.55); backdrop-filter: blur(2px); opacity: 0; transition: opacity .3s var(--ease); }
  .orv.is-open .orv__scrim { opacity: 1; }
  .orv__panel { position: relative; margin: auto; width: min(680px, 100%); max-height: 90vh; background: var(--paper); border-radius: var(--radius-lg); display: flex; flex-direction: column; box-shadow: 0 30px 80px rgba(0,0,0,.4); transform: translateY(16px) scale(.98); opacity: 0; transition: transform .35s var(--ease), opacity .35s var(--ease); }
  .orv.is-open .orv__panel { transform: none; opacity: 1; }
  @media (max-width: 600px) { .orv__panel { max-height: 100vh; height: 100%; border-radius: 0; width: 100%; } }
  .orv__close { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: var(--paper); color: var(--ink); cursor: pointer; display: grid; place-items: center; z-index: 2; }
  .orv__close:hover { background: var(--ink); color: #fff; }
  .orv__close svg { width: 18px; height: 18px; }
  .orv__body { overflow-y: auto; padding: clamp(28px,4vw,44px); }
  .orv__top { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-right: 40px; }
  .orv__mark { flex: none; display: inline-flex; }
  .orv__mark svg { width: 26px; height: 26px; }
  .orv__mark .src-yelp { height: 24px; width: auto; }
  .orv__id { min-width: 0; }
  .orv__name { font-weight: 700; font-size: 1.1rem; }
  .orv__meta { font-size: .85rem; color: var(--muted); }
  .orv__meta:empty { display: none; }
  .orv__stars { margin-left: auto; color: var(--gold); letter-spacing: 1px; white-space: nowrap; }
  .orv__text p { margin: 0 0 12px; color: var(--ink-soft, #3a4048); line-height: 1.65; font-size: 1.02rem; }
  .orv__text p:last-child { margin-bottom: 0; }
</style>
