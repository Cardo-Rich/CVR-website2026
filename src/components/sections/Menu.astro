---
// Shared slide-out Menu drawer used across all public-facing pages.
// Toggles between a light Guests menu and a dark Owners menu; the Owners side
// reuses the property-management splash on its first open of the session.
// The trigger button (`[data-menu-open]`) lives in each page's header.
import { articles } from '../../data/blog';
import { reviews, initial, avatarColor } from '../../data/reviews';
import { CATEGORIES, categoryUrl } from '../../scripts/booking.js';

const ownerFeature = articles.find((a) => a.featured) ?? articles[0];
// A few standout Google reviews for the in-menu carousel.
const menuReviews = reviews.filter((r) => r.platform === 'google').slice(0, 6);
---

<div class="menu" id="site-menu" data-menu aria-hidden="true">
  <div class="menu__scrim" data-menu-close></div>
  <aside class="menu__panel" data-menu-panel data-mode="guests" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="menu__bar">
      <div class="menu__toggle" data-menu-toggle role="tablist" aria-label="Choose menu">
        <span class="menu__thumb" aria-hidden="true"></span>
        <button type="button" class="menu__seg is-active" data-mode-btn="guests" role="tab" aria-selected="true">For Guests</button>
        <button type="button" class="menu__seg" data-mode-btn="owners" role="tab" aria-selected="false">For Owners</button>
      </div>
      <button type="button" class="menu__close" data-menu-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="menu__body">
      <!-- GUESTS -->
      <div class="menu__view" data-view="guests">
        <div class="menu-group">
          <div class="menu-group__h">By Accommodation Type</div>
          <div class="menu-chips">
            {CATEGORIES.map((c) => <a href={categoryUrl(c)}>{c.label}</a>)}
          </div>
        </div>
        <a class="menu-item" href="/#concierge">
          <span class="menu-item__label">Concierge</span>
          <span class="menu-item__sub">Make it a vacation worth remembering</span>
        </a>
        <a class="menu-item" href="/#explore">
          <span class="menu-item__label">Local Faves</span>
          <span class="menu-item__sub">The best of the best</span>
        </a>

        <div class="menu-revs">
          <div class="menu-revs__head">
            <span class="menu-group__h" style="margin:0">Reviews</span>
            <span class="menu-revs__rating"><span class="menu-revs__stars" aria-label="4.8 out of 5">★★★★★</span> 4.8 · 3,500+</span>
          </div>
          <div class="menu-revs__viewport">
            <div class="menu-revs__track">
              {[...menuReviews, ...menuReviews].map((r) => (
                <figure class="menu-rev">
                  <div class="menu-rev__top">
                    <span class="menu-rev__avatar" style={`background:${avatarColor(r.name)};display:grid;place-items:center;color:#fff;font-weight:600`} aria-hidden="true">{initial(r.name)}</span>
                    <span class="menu-rev__g" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg></span>
                    <figcaption class="menu-rev__name">{r.name}</figcaption>
                  </div>
                  <div class="menu-rev__stars" aria-hidden="true">★★★★★</div>
                  <p class="menu-rev__text">{r.text}</p>
                </figure>
              ))}
            </div>
          </div>
          <a class="menu-item__go" href="/reviews">Read all 3,500+ Google &amp; Airbnb reviews →</a>
        </div>
      </div>

      <!-- OWNERS -->
      <div class="menu__view" data-view="owners">
        <a class="menu-item" href="/owners#estimate">
          <span class="menu-item__label">Free Earning Estimate</span>
          <span class="menu-item__sub">Find out what your property can earn</span>
        </a>
        <a class="menu-item" href="/owners/home-designs">
          <span class="menu-item__label">Interior Decorating</span>
          <span class="menu-item__sub">Handled completely for you by professional STR designers</span>
        </a>
        <a class="menu-item" href="/owners/management-fees">
          <span class="menu-item__label">Pricing</span>
          <span class="menu-item__sub">A straight 20%, and what it includes</span>
        </a>
        <a class="menu-item" href="/owners/switch">
          <span class="menu-item__label">Switching Managers</span>
          <span class="menu-item__sub">Change companies without losing bookings</span>
        </a>
        <a class="menu-item" href="/owners#case-studies">
          <span class="menu-item__label">Case Studies</span>
        </a>
        <a class="menu-item" href="/owners#team">
          <span class="menu-item__label">About Us</span>
          <span class="menu-item__sub">Meet the people behind Cardo</span>
        </a>
        <a class="menu-feature" href={`/blog/${ownerFeature.slug}`}>
          <span class="menu-feature__media"><img src={ownerFeature.img} alt="" loading="lazy" /></span>
          <span class="menu-feature__body">
            <span class="menu-feature__kicker">Featured · The Cardo Journal</span>
            <span class="menu-feature__title">{ownerFeature.title}</span>
          </span>
        </a>
      </div>
    </div>

    <!-- Owners first-open splash (reuses the property-management reveal) -->
    <div class="menu__splash" data-menu-splash aria-hidden="true">
      <p class="menu__splash-head">
        <span>Premium Care.</span>
        <span>Proven Performance.</span>
        <span>Peace of Mind.</span>
      </p>
      <p class="menu__splash-sub">Thoughtful management that protects your home, delights your guests, and drives stronger results.</p>
      <div class="menu__splash-reviews">
        <span class="pm-grev">
          <svg class="pm-grev__g" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          <b>Google</b>
        </span>
        <span class="pm-grev__score">4.8</span>
        <span class="pm-grev__stars" aria-label="4.8 out of 5">★★★★★</span>
        <span class="pm-grev__count">127 reviews</span>
      </div>
      <span class="menu__splash-hint">Continue to owners →</span>
    </div>
  </aside>
</div>

<!-- Full-screen brand splash played when a "Manage My Home" nav CTA is clicked -->
<div class="navsplash" data-navsplash aria-hidden="true">
  <div class="navsplash__inner">
    <p class="navsplash__head"><span>Premium Care.</span><span>Proven Performance.</span><span>Peace of Mind.</span></p>
    <p class="navsplash__sub">Thoughtful management that protects your home, delights your guests, and drives stronger results.</p>
    <div class="menu__splash-reviews">
      <span class="pm-grev">
        <svg class="pm-grev__g" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        <b>Google</b>
      </span>
      <span class="pm-grev__score">4.8</span>
      <span class="pm-grev__stars" aria-label="4.8 out of 5">★★★★★</span>
      <span class="pm-grev__count">127 reviews</span>
    </div>
    <div class="navsplash__bar" aria-hidden="true"><i></i></div>
  </div>
</div>

<script>
  // "Manage My Home" → reveal the brand splash on hover/focus as a preview;
  // on click, HOLD the splash (~4.2s, matches the .navsplash__bar animation) so
  // visitors can read the "Premium Care…" verbiage before we forward to owners.
  // Clicking the splash — or the CTA again — skips the wait immediately.
  (function () {
    var splash = document.querySelector('[data-navsplash]');
    var ctas = Array.prototype.slice.call(document.querySelectorAll('a.nav-cta'));
    if (!splash || !ctas.length) return;
    // Reduced-motion users navigate normally (CSS hides the splash entirely).
    if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;

    var HOLD_MS = 4200; // keep in sync with @keyframes navsplash-fill duration
    var HOVER_MS = 140; // hover intent — a quick pass over the button shouldn't fire
    var locked = false; // once clicked, hold shown until we navigate
    var navTimer = null;
    var hoverTimer = null;
    var pendingHref = '/owners';
    // The reveal is deferred two frames so the CSS transition runs. A fast
    // mouse-over/-out would otherwise land its mouseleave *between* those
    // frames, and the queued callback would re-show a splash we'd just hidden
    // — leaving it stuck over the page. `wantShown` is the source of truth.
    var wantShown = false;
    var rafA = 0, rafB = 0;

    function cancelFrames() {
      if (rafA) window.cancelAnimationFrame(rafA);
      if (rafB) window.cancelAnimationFrame(rafB);
      rafA = rafB = 0;
    }
    function show() {
      wantShown = true;
      cancelFrames();
      splash.setAttribute('aria-hidden', 'false');
      rafA = window.requestAnimationFrame(function () {
        rafB = window.requestAnimationFrame(function () {
          rafA = rafB = 0;
          if (wantShown) splash.classList.add('is-shown');
        });
      });
    }
    function preview() { // hover/focus entry point — waits out a quick fly-by
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(show, HOVER_MS);
    }
    function hide() {
      window.clearTimeout(hoverTimer);
      if (locked) return; // don't hide a splash we've committed to navigating from
      wantShown = false;
      cancelFrames();
      splash.classList.remove('is-shown');
      splash.setAttribute('aria-hidden', 'true');
    }
    function go() {
      if (navTimer) { window.clearTimeout(navTimer); navTimer = null; }
      window.location.href = pendingHref;
    }

    ctas.forEach(function (a) {
      a.addEventListener('mouseenter', preview);
      a.addEventListener('mouseleave', hide);
      a.addEventListener('focus', preview);
      a.addEventListener('blur', hide);
      a.addEventListener('click', function (e) {
        e.preventDefault();
        pendingHref = a.getAttribute('href') || '/owners';
        if (locked) { go(); return; } // second click skips the wait
        // Desktop (hover-capable): the splash already previewed on hover, so a
        // click means "take me there" — skip the timed hold entirely.
        if (window.matchMedia('(hover: hover)').matches) { go(); return; }
        locked = true;
        splash.classList.add('is-active'); // starts the progress bar
        show();
        navTimer = window.setTimeout(go, HOLD_MS);
      });
    });

    // Safety net: the splash is pointer-events:none during the preview, so any
    // mouse activity elsewhere on the page means the cursor has left the CTA.
    // Catches a mouseleave the browser never delivered (fast slide, pointer
    // leaving the window) instead of stranding the splash on screen.
    document.addEventListener('mouseover', function (e) {
      if (locked || !wantShown) return;
      var t = e.target;
      if (t && t.closest && t.closest('a.nav-cta')) return;
      hide();
    });
    // Same idea for tab-away / window blur while the preview is up.
    window.addEventListener('blur', function () { if (!locked) hide(); });

    // Click anywhere on the held splash to continue immediately.
    splash.addEventListener('click', function () { if (locked) go(); });
  })();
</script>

<script>
  (function () {
    const openBtn = document.querySelector('[data-menu-open]');
    const menu = document.querySelector('[data-menu]');
    const panel = document.querySelector('[data-menu-panel]');
    const splash = document.querySelector('[data-menu-splash]');
    if (!openBtn || !menu || !panel) return;

    const segs = Array.prototype.slice.call(menu.querySelectorAll('[data-mode-btn]'));
    const closers = Array.prototype.slice.call(menu.querySelectorAll('[data-menu-close]'));
    const SPLASH_KEY = 'cardoOwnerSplashSeen';
    const MODE_KEY = 'cardoMenuMode';
    let splashTimer = null;

    // Apply a mode with no animation/splash — used to restore the last choice on load.
    function applyModeInstant(mode) {
      panel.setAttribute('data-mode', mode);
      segs.forEach(function (s) {
        const on = s.getAttribute('data-mode-btn') === mode;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    function openMenu() {
      menu.classList.add('is-open');
      menu.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('menu-open');
    }
    function closeMenu() {
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-open');
      hideSplash();
    }

    function hideSplash() {
      if (!splash) return;
      clearTimeout(splashTimer);
      splash.classList.remove('is-shown');
      splash.setAttribute('aria-hidden', 'true');
    }
    function showSplash() {
      if (!splash) return;
      splash.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { splash.classList.add('is-shown'); });
      });
      clearTimeout(splashTimer);
      splashTimer = setTimeout(hideSplash, 3000);
    }

    function setMode(mode) {
      if (panel.getAttribute('data-mode') === mode) return;
      panel.setAttribute('data-mode', mode);
      try { localStorage.setItem(MODE_KEY, mode); } catch (e) {}
      segs.forEach(function (s) {
        const on = s.getAttribute('data-mode-btn') === mode;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (mode === 'owners') {
        let seen = false;
        try { seen = sessionStorage.getItem(SPLASH_KEY) === '1'; } catch (e) {}
        if (!seen) {
          showSplash();
          try { sessionStorage.setItem(SPLASH_KEY, '1'); } catch (e) {}
        }
      } else {
        hideSplash();
      }
    }

    // Restore the last-selected side across page navigations.
    try {
      const savedMode = localStorage.getItem(MODE_KEY);
      if (savedMode === 'owners') applyModeInstant('owners');
    } catch (e) {}

    openBtn.addEventListener('click', openMenu);
    closers.forEach(function (c) { c.addEventListener('click', closeMenu); });
    // Any in-menu navigation link closes the drawer so it unlocks page scroll
    // (html.menu-open sets overflow:hidden). Without this a same-page hash link
    // — e.g. Pricing while already on /owners — can't scroll. The owner-side
    // splash CTA (a.nav-cta) manages its own timed navigation, so leave it be.
    panel.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (a && !a.classList.contains('nav-cta')) closeMenu();
    });
    segs.forEach(function (s) {
      s.addEventListener('click', function () { setMode(s.getAttribute('data-mode-btn')); });
    });
    if (splash) splash.addEventListener('click', hideSplash);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) closeMenu();
    });
  })();
</script>
