---
// V3 guest header: light-sand bar, a centered nav search that appears on
// scroll, and a right-aligned "Menu" drawer (shared <Menu /> component).
import Menu from './Menu.astro';
import { AREAS, GUEST_OPTIONS, GUESTS_DEFAULT, today, addDays, defaultCheckIn, defaultCheckOut } from '../../scripts/booking.js';

// Build-time dates; guest.js re-stamps them on load (see BookingHero).
const checkIn = defaultCheckIn();
const checkOut = defaultCheckOut();
---

<header class="site-header" data-header data-screen-label="Header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Cardo — home">
      <img src="/assets/logo-horizontal-color.png" alt="Cardo Vacation Rentals" />
    </a>
    <!-- Sits between the logo and the CTA so it can use the whole gap they
         leave — see .navsearch in home.css. -->
    <form class="navsearch" data-navsearch aria-label="Search rentals">
      <svg class="navsearch__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <select class="navsearch__where" aria-label="Where">{AREAS.map((a) => <option>{a.label}</option>)}</select>
      <span class="navsearch__div"></span>
      <input type="date" value={checkIn} data-default={checkIn} min={today()} aria-label="Check in" />
      <span class="navsearch__div"></span>
      <input type="date" value={checkOut} data-default={checkOut} min={addDays(today(), 1)} aria-label="Check out" />
      <span class="navsearch__div navsearch__div--guests"></span>
      <select class="navsearch__guests" aria-label="Guests">
        {GUEST_OPTIONS.map((g) => <option value={g.value} selected={g.value === GUESTS_DEFAULT}>{g.label}</option>)}
      </select>
      <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
    </form>
    <nav class="site-header__nav site-header__nav--guest">
      <a class="nav-cta" href="/owners"><span>Manage My Home</span></a>
      <button type="button" class="menu-btn" data-menu-open aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
        <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </nav>
  </div>
</header>

<Menu />

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
