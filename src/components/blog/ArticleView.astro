---
// The Journal article body: header, hero, prose, CTA, area links, and the
// "keep reading" strip. Shared by the live page (/blog/[slug]) and the
// unlisted draft preview (/blog/preview/[key]) so both render identically.
import type { Article } from '../../data/blog';

interface RelatedCard { slug: string; title: string; category: string; img: string }
interface Area { slug: string; name: string }

interface Props {
  a: Article;
  related: RelatedCard[];
  areas: Area[];
  /** Guest guides get a booking CTA; owner articles the earning-estimate CTA. */
  isGuestGuide: boolean;
  /** Set on the draft preview page: shows the banner and marks the article. */
  previewNote?: string;
}
const { a, related, areas, isGuestGuide, previewNote } = Astro.props;
---

<article data-screen-label="Article" data-cms="blog-article" data-blog-detail={a.slug} data-blog-preview={previewNote ? '' : undefined}>
  {previewNote && (
    <div class="art-preview" role="status">
      <strong>Draft preview.</strong> {previewNote}
    </div>
  )}
  <div class="art-head">
    <a href="/blog" class="link-arrow" style="border:0;font-size:.9rem;color:var(--muted);margin-bottom:18px">← The Cardo Journal</a>
    <div class="post-cat" data-blog-cat>{a.category}</div>
    <h1 data-blog-title>{a.title}</h1>
    <div class="art-byline">
      <div class="art-avatar" data-blog-initials>{a.author.initials}</div>
      <div>
        <div class="who" data-blog-author>{a.author.name}</div>
        <div class="meta" data-blog-meta>{a.dateFull} · {a.readTime}</div>
      </div>
    </div>
  </div>

  <div class="art-hero">
    <figure>
      <img src={a.img} alt={a.title} data-blog-img />
      <figcaption data-blog-caption>{a.heroCaption}</figcaption>
    </figure>
  </div>

  <div class="prose" set:html={a.bodyHtml} data-blog-body />

  <div class="art-cta">
    {isGuestGuide ? (
      <div class="art-cta__box">
        <h3>Make it a San Diego trip.</h3>
        <p>Browse Cardo's vacation homes across San Diego, thoughtfully designed, spotless, and right where you want to be, from La Jolla to Coronado. Book direct and reach a local team 24/7.</p>
        <a href="https://booking.cardorentals.com" class="btn btn-lg">Find your San Diego stay</a>
      </div>
    ) : (
      <div class="art-cta__box">
        <h3>What could your San Diego home earn with Cardo?</h3>
        <p>Get a free, no-obligation earning estimate built for your exact home: your address, size, and finish run against live San Diego demand. You'll see the annual revenue we project, how it compares to your current market, and how we'd get you there. Most estimates come back within one business day.</p>
        <a href="/owners#estimate" class="btn btn-lg">Get my free earning estimate</a>
      </div>
    )}
  </div>
  {areas.length > 0 && (
    <div class="art-areas">
      <span class="art-areas__label">Areas in this guide</span>
      <div class="art-areas__links">
        {areas.map((nh) => (
          <a href={`/neighborhoods/${nh.slug}`}>{nh.name} rentals →</a>
        ))}
      </div>
    </div>
  )}
</article>

<!-- RELATED -->
<section class="related" data-screen-label="Related">
  <div class="related__inner">
    <div class="section-head" style="margin-bottom:0">
      <p class="eyebrow">Keep reading</p>
      <h2>More from the Journal.</h2>
    </div>
    <div class="related__grid">
      {related.map((r) => (
        <a class="rpost" href={`/blog/${r.slug}`}>
          <img src={r.img} alt="" loading="lazy" />
          <div class="rpost__b">
            <span class="post-cat" style="color:var(--rose);font-size:.74rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase">{r.category}</span>
            <h4>{r.title}</h4>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .art-preview { max-width: var(--container-narrow); margin: 96px auto -72px; padding: 12px 16px; border-radius: var(--radius-md, 10px); background: #fff3cd; color: #5c4400; font-size: .92rem; border: 1px solid #f0d98a; }
  .art-head { max-width: var(--container-narrow); margin: 0 auto; padding: 124px 24px 0; }
  .art-head .post-cat { color: var(--rose); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; font-size: .78rem; }
  .art-head h1 { font-size: clamp(2.2rem,4.4vw,3.4rem); margin: 14px 0 20px; }
  .art-byline { display: flex; align-items: center; gap: 14px; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .art-avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 1.05rem; }
  .art-byline .who { font-weight: 600; color: var(--ink); font-size: .95rem; }
  .art-byline .meta { font-size: .85rem; color: var(--muted); }

  .art-hero { max-width: var(--container); margin: 36px auto 0; padding: 0 24px; }
  .art-hero figure { margin: 0; }
  .art-hero img { width: 100%; aspect-ratio: 16/8; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .art-hero figcaption { font-size: .82rem; color: var(--muted); margin-top: 12px; text-align: center; }

  .prose { max-width: 720px; margin: 0 auto; padding: clamp(40px,6vw,64px) 24px clamp(40px,6vw,64px); }

  .art-areas { max-width: 720px; margin: 0 auto; padding: 0 24px clamp(40px,6vw,64px); }
  .art-areas__label { display: block; font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: var(--gold-deep); font-weight: 600; margin-bottom: 12px; }
  .art-areas__links { display: flex; flex-wrap: wrap; gap: 10px; }
  .art-areas__links a { font-size: .92rem; font-weight: 500; color: var(--ink); background: var(--cream-2); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; text-decoration: none; transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  .art-areas__links a:hover { color: var(--rose); border-color: var(--rose); }

  .art-cta { max-width: 720px; margin: 0 auto 0; padding: 0 24px clamp(48px,7vw,80px); }
  .art-cta__box { background: var(--ink); border-radius: var(--radius-lg); padding: clamp(32px,5vw,48px); text-align: center; }
  .art-cta__box h3 { color: #fff; font-size: 1.7rem; margin: 0 0 10px; }
  .art-cta__box p { color: rgba(248,243,236,.82); margin: 0 0 22px; }

  .related { background: var(--cream-2); }
  .related__inner { max-width: var(--container); margin: 0 auto; padding: clamp(56px,8vw,88px) 24px; }
  .related__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; margin-top: 32px; }
  .rpost { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .rpost:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .rpost img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .rpost__b { padding: 22px; }
  .rpost__b h4 { font-family: var(--font-display); font-weight: 500; font-size: 1.18rem; margin: 8px 0 0; color: var(--ink); }
  @media (max-width: 820px) { .related__grid { grid-template-columns: 1fr; max-width: 460px; } }
</style>

<!-- The article body is injected with set:html, so its elements carry no
     Astro scope attribute and a scoped rule like `.prose p` never matches
     them. These rules are global on purpose, namespaced under .prose. -->
<style is:global>
  .prose .lede { font-size: 1.32rem; line-height: 1.5; color: var(--ink); font-family: var(--font-display); font-weight: 400; margin-bottom: 28px; }
  .prose p { font-size: 1.12rem; line-height: 1.72; color: var(--ink-soft); margin: 0 0 1.3em; }
  .prose h2 { font-size: 1.7rem; margin: 1.6em 0 .5em; }
  .prose h3 { font-size: 1.3rem; margin: 1.4em 0 .4em; }
  .prose ul { margin: 0 0 1.4em; padding: 0; list-style: none; }
  .prose ul li { position: relative; padding-left: 28px; margin-bottom: 12px; font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft); }
  .prose ul li::before { content: ""; position: absolute; left: 4px; top: 11px; width: 7px; height: 7px; border-radius: 50%; background: var(--rose); }
  .prose ol { margin: 0 0 1.4em; padding-left: 28px; }
  .prose ol li { margin-bottom: 12px; font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft); }
  .prose blockquote { margin: 1.6em 0; padding: 4px 0 4px 28px; border-left: 3px solid var(--rose); font-family: var(--font-display); font-size: 1.5rem; line-height: 1.35; color: var(--ink); }
  .prose blockquote p { font: inherit; color: inherit; margin: 0; }
  .prose a.inline, .prose p a { color: var(--rose); border-bottom: 1px solid var(--accent-soft); text-decoration: none; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2em 0; }
  .prose img { max-width: 100%; height: auto; border-radius: var(--radius-lg); }

  .prose .callout { background: var(--cream-2); border-radius: var(--radius-lg); padding: 28px 30px; margin: 1.8em 0; }
  .prose .callout .eyebrow { margin-bottom: 10px; }
  .prose .callout p { margin: 0; font-size: 1.05rem; color: var(--ink-soft); }
</style>
